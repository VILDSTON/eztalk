# MongoDB connection URI (from MongoDB Atlas)
# Replace with your own credentials
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/eztalk?retryWrites=true&w=majority

# Server Port
PORT=5050

# Frontend only: Backend URL (if frontend is hosted on Netlify/Vercel)
# VITE_API_URL=https://your-backend.onrender.com
