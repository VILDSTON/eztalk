# MongoDB connection URI (from MongoDB Atlas)
# Replace with your own credentials
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/eztalk?retryWrites=true&w=majority

# Server Port
PORT=5050

# Frontend only: Backend URL (if frontend is hosted on Netlify/Vercel)
# VITE_API_URL=https://your-backend.onrender.com

# Cloudinary Configuration (REQUIRED for production on Render)
# Render Free Tier has an ephemeral disk (files in uploads/ are wiped on sleep or reboot).
# Create a free account at https://cloudinary.com (free 25GB storage) and fill in your keys:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
