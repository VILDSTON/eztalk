# ==============================================================================
# EzTalk Environment Configuration Template
# NOTE: Never commit production credentials, JWT secrets, or DB passwords!
# ==============================================================================

# --- Backend Private Configuration (Server-Only, Never exposed to client) ---
PORT=5050
NODE_ENV=development

# MongoDB Atlas or Local Connection String
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0"

# JWT Token Secret (Use a strong random 32+ character string in production)
JWT_SECRET="your_secure_jwt_secret_key_change_in_production"

# Gemini AI API Key (Required for EzTalk AI Bot)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Supabase Storage Configuration (Used only on server for file uploads)
SUPABASE_URL="https://<project-id>.supabase.co"
SUPABASE_KEY="<service_role_or_private_key>"
SUPABASE_BUCKET="chat-attachments"

# SMTP Email Configuration (Optional in dev, required for real emails in production)
# Examples: smtp.gmail.com, smtp-relay.brevo.com, smtp.mailgun.org, etc.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_specific_password"
SMTP_FROM="\"EzTalk Security\" <no-reply@eztalk.app>"

# Resend HTTPS Email API (Recommended for Render, Vercel, Railway where SMTP ports are blocked)
# Get free API key from https://resend.com (3000 free emails/mo, zero SMTP port blocks)
RESEND_API_KEY=""
RESEND_FROM="EzTalk Security <onboarding@resend.dev>"

# Optional: Auto-fill verification code in UI/logs for testing
SHOW_VERIFICATION_CODE=false

# --- Frontend Public Configuration (Vite-exposed, Safe for browser) ---
# When running in dev or behind a reverse proxy/domain, configure client API URL:
# VITE_API_URL="https://api.eztalk.app"
