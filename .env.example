# ==============================================================================
# EzTalk Environment Configuration Template
# NOTE: Never commit production credentials, JWT secrets, or DB passwords!
# ==============================================================================

# --- Backend Private Configuration (Server-Only, Never exposed to client) ---
PORT=5050
NODE_ENV=development

# MongoDB Atlas or Local Connection String
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0"

# JWT Token Secret (Use a strong random 32+ character string in production)
JWT_SECRET="your_secure_jwt_secret_key_change_in_production"

# Supabase Storage Configuration (Used only on server for file uploads)
SUPABASE_URL="https://<project-id>.supabase.co"
SUPABASE_KEY="<service_role_or_private_key>"
SUPABASE_BUCKET="chat-attachments"

# --- Frontend Public Configuration (Vite-exposed, Safe for browser) ---
# When running in dev or behind a reverse proxy/domain, configure client API URL:
# VITE_API_URL="https://api.eztalk.app"
